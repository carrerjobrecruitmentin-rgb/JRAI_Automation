# JobRecruitmentAI Automation Environment Template
# Copy this file to .env and insert your real credentials

# Cloudflare Configuration
CF_API_TOKEN=your_cloudflare_api_token
CF_ZONE=jobrecruitment.ai
CF_TUNNEL_ID=your_tunnel_id_here
CF_TUNNEL_NAME=jrai-automation

# Hostinger Production Database
DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# AI APIs (Gemini & Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Services Ports
CV_PARSER_PORT=8000
GOV_JOB_API_PORT=8005
